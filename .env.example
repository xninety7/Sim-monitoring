# Set DATABASE_URL to a shared PostgreSQL connection string before starting the app.
# Example for a local PostgreSQL instance:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sim_monitoring
HOST=127.0.0.1
PORT=8000
# Optional: set true only for a trusted first setup to import the 115 demo records.
SEED_DEMO_DATA=false
# Optional: Sign in with Lark (see README). Leave empty to use passwords only.
LARK_APP_ID=
LARK_APP_SECRET=
